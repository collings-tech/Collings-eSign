PORT=4000
MONGO_URI=mongodb+srv://your_mongo_connection_here
# Required in production; the server refuses to start without it. Generate with: openssl rand -hex 48
JWT_SECRET=
# Max PDF upload size in bytes (default 25MB)
MAX_UPLOAD_BYTES=26214400
UPLOAD_DIR=uploads
CLIENT_ORIGIN=http://localhost:5173

# Supabase Storage (optional; when set, PDFs are stored in Supabase instead of local disk)
# Create a bucket named "documents" (private). Use service role key for upload/download/signed URLs.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=documents
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
RECAPTCHA_SECRET_KEY=


DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=
